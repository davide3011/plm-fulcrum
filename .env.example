# Copy this file to .env and fill in real values.
# .env is gitignored and never committed.
# Both palladiumd and Fulcrum read RPC credentials from here.

RPC_USER=palladiumrpc
RPC_PASSWORD=change-me-strong-password

# palladium-node tuning
MAX_CONNECTIONS=50

# Public peering (Fulcrum-to-Fulcrum discovery) — required if you want this
# server to announce itself to other Electrum servers on the network.
#
# PUBLIC_HOST: the public IP of THIS specific server (no DNS hostname
# needed). Every VPS running this stack must set its OWN IP here — do not
# copy the same value across multiple deployments.
# PUBLIC_TCP_PORT / PUBLIC_SSL_PORT: the Electrum TCP/SSL ports as reachable
# from outside this host. Match the host side of the "ports:" mapping in
# docker-compose.yml if you remapped them away from the 50001/50002 default.
# ANNOUNCE: set to false to discover other peers without advertising this
# server in their lists (peering still stays enabled either way).
PUBLIC_HOST=YOUR_SERVER_PUBLIC_IP
PUBLIC_TCP_PORT=50001
PUBLIC_SSL_PORT=50002
ANNOUNCE=true
