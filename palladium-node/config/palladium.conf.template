# ============================================================
# Palladium Core configuration
# Generated at container startup by entrypoint.sh via envsubst.
# DO NOT edit this file directly — edit .env instead.
# ============================================================

# --- RPC credentials (set in .env) ---
rpcuser=${RPC_USER}
rpcpassword=${RPC_PASSWORD}

# --- Node behaviour ---
server=1
listen=1
daemon=0           # must be 0 inside Docker (foreground)
discover=1
txindex=1

# --- Network bindings ---
bind=0.0.0.0
port=2333
rpcport=2332
rpcbind=0.0.0.0

# Allow RPC from RFC-1918 ranges (covers Docker bridge and host networks)
rpcallowip=10.0.0.0/8
rpcallowip=172.16.0.0/12
rpcallowip=192.168.0.0/16

# --- Peers ---
maxconnections=${MAX_CONNECTIONS}
fallbackfee=0.0001

seednode=dnsseed.palladium-coin.store
addnode=89.117.149.130:2333
addnode=66.94.115.80:2333
addnode=173.212.224.67:2333
addnode=82.165.218.152:2333

# --- ZeroMQ (used by Fulcrum for real-time block/tx notifications) ---
zmqpubhashblock=tcp://0.0.0.0:28332
zmqpubhashtx=tcp://0.0.0.0:28333
zmqpubrawblock=tcp://0.0.0.0:28334
zmqpubrawtx=tcp://0.0.0.0:28335
