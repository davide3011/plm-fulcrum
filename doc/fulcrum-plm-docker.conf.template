# Fulcrum configuration for Palladium (PLM) — Docker container
# Generated at container startup by fulcrum-entrypoint.sh via envsubst.
# DO NOT edit directly — set values in the root .env file.

datadir = /data/db

bitcoind    = palladiumd:2332
rpcuser     = ${RPC_USER}
rpcpassword = ${RPC_PASSWORD}

tcp = 0.0.0.0:50001
ssl = 0.0.0.0:50002
cert = /data/ssl/fulcrum-plm.crt
key  = /data/ssl/fulcrum-plm.key

# Bound to 0.0.0.0 inside the container — host-only exposure is enforced by
# the "127.0.0.1:8000:8000" port mapping in docker-compose.yml, not here.
admin = 0.0.0.0:8000

peering  = true
hostname = ${PUBLIC_HOST}
announce = ${ANNOUNCE}
public_tcp_port = ${PUBLIC_TCP_PORT}
public_ssl_port = ${PUBLIC_SSL_PORT}
